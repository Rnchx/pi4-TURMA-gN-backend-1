NODE_ENV=development
PORT=4000
# O Node roda na máquina e usa a porta publicada pelo Docker em 127.0.0.1.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safra
# Valores demonstrativos. No .env, use credenciais próprias; o Compose cria o banco com elas.
DB_USER=seu_usuario
DB_PASSWORD=configure_localmente
# Origens exatas, separadas por vírgulas. Em produção, informe somente o site publicado.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006

# Serviço de Confirmação em Java (Docker Compose).
# JAVA_PORT: porta publicada em 127.0.0.1 na máquina. JAVA_SERVER_PORT: porta interna do contêiner.
JAVA_PORT=8080
JAVA_SERVER_PORT=8080
# Endereço do Serviço de Confirmação para a API rodando na máquina (npm start).
# No Docker Compose a API usa http://confirmacao-java:8080, definido no compose.yaml.
CONFIRMACAO_URL=http://localhost:8080

# API SAFRA no Docker Compose (serviço `api`).
# API_PORT: porta publicada na máquina.
# API_BIND_ADDRESS:
#   127.0.0.1 (padrão e uso seguro): a API só é acessível neste computador (Expo Web, testes).
#   0.0.0.0: publica a API para toda a rede local. Use somente durante o teste em aparelho físico
#            (Expo Go), em rede confiável, e volte para 127.0.0.1 depois. A API não tem autenticação.
#   Recrie só a API ao trocar: docker compose up -d --no-deps api
# No frontend (.env.local, não versionado), aponte para o IP do computador na rede, por exemplo:
#   EXPO_PUBLIC_API_URL=http://192.168.0.64:4000
API_PORT=4000
API_BIND_ADDRESS=127.0.0.1
